# Copy to .env (gitignored) and fill in. Never commit .env.

# Bearer token from the sandbox dashboard (https://sandbox.kadimadashboard.com).
# Needs permission api-creditcard-payment-read-write for card payments / hosted fields.
KADIMA_MERCHANT_TOKEN=
# Optional: agent token, used only when a reporting tool is called with auth="agent".
KADIMA_AGENT_TOKEN=

# Dashboard terminal.id used for every gateway call (each tool also accepts terminal_id).
KADIMA_TERMINAL_ID=
# DBA id used by CustomerVault, ACH, hosted forms and reporting (each tool also accepts dba_id).
KADIMA_DBA_ID=

# Environment. Defaults to sandbox. "live" is refused unless KADIMA_ALLOW_LIVE=true as well.
KADIMA_ENV=sandbox
KADIMA_ALLOW_LIVE=false

# Optional: where statement PDFs are saved (default: ./downloads next to this file).
# KADIMA_DOWNLOAD_DIR=
# Optional: request timeout in ms (default 30000).
# KADIMA_TIMEOUT_MS=30000
